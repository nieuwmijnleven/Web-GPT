# DevSpace runtime configuration. Put DEVSPACE_ALLOWED_ROOTS and DEVSPACE_EXECUTABLE in /etc/devspace/devspace.env.
DEVSPACE_HOST=127.0.0.1 # Loopback bind address.
DEVSPACE_PORT=9191 # Local MCP port.
DEVSPACE_MCP_PATH=/mcp # Fixed MCP path in the installed server.
DEVSPACE_MCP_URL=http://127.0.0.1:9191/mcp # Private loopback MCP endpoint.
DEVSPACE_ALLOWED_ROOTS=/srv/devspace-workspaces # Comma-separated absolute workspace roots.
DEVSPACE_EXECUTABLE=/usr/local/bin/devspace # Absolute DevSpace executable path for the service wrapper.
DEVSPACE_SERVICE_USER=devspace # Dedicated unprivileged service account.
DEVSPACE_PUBLIC_BASE_URL=http://127.0.0.1:9191 # OAuth resource base advertised locally by DevSpace.
OAUTH_PUBLIC_BASE_URL=https://auth.example.com # Public HTTPS OAuth origin advertised by the gateway.
MCP_PUBLIC_RESOURCE_URL=https://auth.example.com/mcp # Canonical public MCP resource identifier.
OAUTH_GATEWAY_LISTEN_ADDR=127.0.0.1:9292 # Loopback-only OAuth-aware gateway.
DEVSPACE_LOG_LEVEL=info # JSON journald verbosity.
DEVSPACE_AUTH_TOKEN= # Project-level name; the installed server uses its owner token file.
DEVSPACE_OAUTH_OWNER_TOKEN= # Existing DevSpace owner secret; keep outside Git.
DEVSPACE_AUTH_HEADER= # The installed server uses OAuth bearer headers instead.
DEVSPACE_REQUEST_TIMEOUT= # Tunnel-client-owned; no DevSpace setting in this release.
DEVSPACE_SESSION_TIMEOUT= # DevSpace session cleanup is fixed by this release.

# OpenAI Secure MCP Tunnel values obtained from Platform tunnel settings.
OPENAI_TUNNEL_ID= # Tunnel identifier; not generated locally.
OPENAI_TUNNEL_RUNTIME_KEY= # Restricted runtime key; never use the admin key here.
OPENAI_MCP_TUNNEL_TARGET_URL=http://127.0.0.1:9292/mcp # Tunnel target; the gateway proxies to DEVSPACE_MCP_URL.
OPENAI_ORGANIZATION_ID= # Platform organization associated with the tunnel.
CHATGPT_WORKSPACE_ID= # ChatGPT Business workspace associated with the tunnel.
OPENAI_TUNNEL_PROFILE=devspace # Installed tunnel-client profile name.
TUNNEL_LOG_LEVEL=info # tunnel-client log level.
TUNNEL_HEALTH_LISTEN_ADDR=127.0.0.1:8080 # Loopback health/readiness listener.
