[Unit]
Description=OpenAI Secure MCP Tunnel client for DevSpace
Requires=devspace.service devspace-oauth-gateway.service
After=devspace.service devspace-oauth-gateway.service network-online.target
Wants=network-online.target
PartOf=devspace.service devspace-oauth-gateway.service

[Service]
Type=simple
User=devspace
Group=devspace
WorkingDirectory=/var/lib/devspace
Environment=HOME=/var/lib/devspace
EnvironmentFile=/etc/devspace/openai-mcp-tunnel.env
ExecStartPre=/usr/bin/bash -c 'i=0; while [ "$i" -lt 30 ]; do /usr/bin/curl --compressed --fail --silent --show-error --max-time 2 http://127.0.0.1:9292/healthz >/dev/null && exit 0; i=$((i + 1)); /usr/bin/sleep 1; done; exit 1'
ExecStart=/usr/local/libexec/run-openai-mcp-tunnel
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/devspace
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
